# Copy to .env and fill in. Never commit .env.

PORT=4000
# The web app's origin (Vite dev server). Only this origin may call the API.
FRONTEND_ORIGIN=http://localhost:5173

# MySQL (the least-privilege user created by db/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gbv_app
DB_PASSWORD=change-this-password
DB_NAME=gbv_consent

# Hardhat Network
RPC_URL=http://127.0.0.1:8545
# Gateway/relayer key = Hardhat test account #1 (printed by `npx hardhat node`).
# It is a public TEST key: never use it, or any key copied from here, on a real network.
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# IPFS Desktop / Kubo RPC API
IPFS_API_URL=http://127.0.0.1:5001

# Secrets: generate each with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
STAFF_REF_KEY=
JWT_SECRET=

# Settings recorded in Chapter 4
JWT_LIFETIME_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MAX_EVIDENCE_FILES=5
MAX_EVIDENCE_FILE_MB=10
PENDING_SUBMISSION_MINUTES=15
REPORTER_PROOF_MAX_AGE_SECONDS=300
# Submissions per hour per IP. Keep 20 in normal use; the evaluation harness needs a high
# value (for example 5000) to run its hundreds of trials.
RATE_LIMIT_SUBMITS_PER_HOUR=20
# Reporter portal reads per 15 minutes per IP. Same story: raise it only for the evaluation.
RATE_LIMIT_PORTAL_PER_15MIN=60
# Sign-in attempts per 15 minutes per IP.
RATE_LIMIT_LOGIN_PER_15MIN=30
# All API requests per minute per IP.
RATE_LIMIT_API_PER_MIN=300
